{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/healthz", "destination": "https://sparrow-backend-kixz.onrender.com/healthz" },
    { "source": "/auth/:path*", "destination": "https://sparrow-backend-kixz.onrender.com/auth/:path*" },
    { "source": "/databases", "destination": "https://sparrow-backend-kixz.onrender.com/databases" },
    { "source": "/databases/:path*", "destination": "https://sparrow-backend-kixz.onrender.com/databases/:path*" },
    { "source": "/tokens/:path*", "destination": "https://sparrow-backend-kixz.onrender.com/tokens/:path*" },
    { "source": "/usage/:path*", "destination": "https://sparrow-backend-kixz.onrender.com/usage/:path*" },
    { "source": "/storage/:path*", "destination": "https://sparrow-backend-kixz.onrender.com/storage/:path*" },
    { "source": "/subscribe/:path*", "destination": "https://sparrow-backend-kixz.onrender.com/subscribe/:path*" },
    { "source": "/pipeline", "destination": "https://sparrow-backend-kixz.onrender.com/pipeline" },
    { "source": "/login", "destination": "/auth.html" },
    { "source": "/signup", "destination": "/auth.html" },
    { "source": "/dashboard", "destination": "/dashboard.html" },
    { "source": "/:cmd/:path*", "destination": "https://sparrow-backend-kixz.onrender.com/:cmd/:path*" }
  ]
}
