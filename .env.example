[TEMPLATE]
# Sparrow configuration (all optional — sane defaults for local dev)
# NOTE: config.js reads real environment variables only (no .env loader),
# but both SPARROW_* and legacy REDEX_* names are honored where supported.

# ── HTTP surface ────────────────────────────────────────────────
REDEX_HOST=127.0.0.1
REDEX_PORT=8080

# ── Control plane database (SQLite) ─────────────────────────────
REDEX_SQLITE_PATH=./data/control.db

# ── Persistence (per-tenant AOF + RDB) ──────────────────────────
REDEX_DATA_DIR=./data/engine
REDEX_AOF_ENABLED=1
REDEX_AOF_FSYNC=always        # always | everysec | no
REDEX_RDB_SAVE_SECONDS=900    # periodic snapshot cadence
REDEX_RDB_SAVE_MIN_CHANGES=10

# ── Limits & quotas (per tenant database) ───────────────────────
REDEX_MAX_KEYS=100000
REDEX_MAX_MEMORY_BYTES=134217728   # 128 MiB
REDEX_MAX_VALUE_BYTES=1048576      # 1 MiB
REDEX_MAX_PAYLOAD_BYTES=1048576    # per HTTP request body
REDEX_MAX_DB_NAME=64
REDEX_MAX_DB_PER_USER=10

# ── Rate limiting (token bucket, per token) ─────────────────────
REDEX_RL_CAPACITY=200
REDEX_RL_REFILL_PER_SEC=100
REDEX_RL_MAX_BURST=400

# ── Engine ──────────────────────────────────────────────────────
REDEX_RESP_PORT=6379           # 0 disables the internal RESP listener

# ── Console / sessions ─────────────────────────────────────────
REDEX_SESSION_TTL_HOURS=168    # 7 days
