# Sparrow — systemd service
#
# Install (Ubuntu/Debian, as root):
#   cp deploy/sparrow.service /etc/systemd/system/
#   # edit User=, WorkingDirectory= and Environment= paths to match your setup
#   systemctl daemon-reload
#   systemctl enable --now sparrow
#   journalctl -u sparrow -f        # tail the logs
#
# Requirements: Node.js >= 22.5 installed on the host (https://nodejs.org).

[Unit]
Description=Sparrow — Redis over REST
After=network.target
Wants=network.target

[Service]
Type=simple
# Run as a dedicated unprivileged user (recommended):
#   useradd --system --home /opt/sparrow --shell /usr/sbin/nologin sparrow
#   mkdir -p /var/lib/sparrow && chown sparrow:sparrow /var/lib/sparrow
User=sparrow
Group=sparrow
WorkingDirectory=/opt/sparrow
ExecStart=/usr/bin/node src/index.js
Restart=always
RestartSec=3

# Data (engine + control-plane SQLite) lives here — back this up
Environment=REDEX_DATA_DIR=/var/lib/sparrow/data
Environment=REDEX_SQLITE_PATH=/var/lib/sparrow/control.db

# Listen only on loopback — Caddy/nginx terminates TLS in front
Environment=REDEX_HOST=127.0.0.1
Environment=REDEX_PORT=8080

# RESP debug server: keep it OFF on a public host unless you need it
Environment=REDEX_RESP_PORT=0

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/sparrow

# Graceful shutdown
KillSignal=SIGTERM
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
